<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="servicebot">

  <!-- Materials (shared across all assemblies) -->
  <material name="Steel">
    <color rgba="0.627 0.627 0.627 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find servicebot_description)/urdf/assemblies/servicebot.urdf.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:servicebot prefix=""/>

</robot>